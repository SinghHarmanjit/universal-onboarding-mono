{
  "name": "universal-onboarding-mono",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@11.9.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "prepare": "test -z \"$CI\" && test -d .git && husky || true"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "turbo": "^2.1.0"
  }
}
